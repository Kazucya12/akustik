# Salin ke .env untuk uji lokal (vercel dev). JANGAN di-commit.
# Di Vercel: Project > Settings > Environment Variables.
YOUTUBE_API_KEY=
# Opsional: API musik sendiri. {q} = kata kunci, {key} = MUSIC_API_KEY
MUSIC_API_URL=
MUSIC_API_KEY=
# SoundStat (rekomendasi suasana/aktivitas). Daftar key di https://soundstat.info/auth.html
SOUNDSTAT_API_KEY=
# Audius (opsional, API key publik dari audius.co/settings > Developer Apps). Jangan isi API secret.
AUDIUS_API_KEY=

# Jamendo (opsional, musik bebas lisensi). Client ID gratis di https://devportal.jamendo.com
JAMENDO_CLIENT_ID=

# Daftar & Masuk (v3.5)
# Email kode verifikasi dikirim dari Gmail kamu. GMAIL_APP_PASSWORD = Sandi Aplikasi 16 huruf
# (Akun Google > Keamanan > Verifikasi 2 langkah aktif > Sandi aplikasi). BUKAN password Gmail biasa.
GMAIL_USER=
GMAIL_APP_PASSWORD=
# String acak panjang (min 16 karakter), contoh: openssl rand -hex 32
AUTH_SECRET=
# Database akun: Upstash Redis (Vercel > Storage / Marketplace > Upstash Redis > Connect Project).
# Vercel mengisi salah satu pasangan ini otomatis:
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# atau: KV_REST_API_URL= dan KV_REST_API_TOKEN=
