          </adaptive-icon>
          LOOPIFY_EOF
          echo '' | base64 -d > android/app/loopify.jks
          sed -i "s|__URL__|$APP_URL|; s|__VC__|$GITHUB_RUN_NUMBER|g" android/app/build.gradle
          test -f apk-icon.png || { echo "File apk-icon.png belum ada di repo. Upload dulu ke folder utama repo."; exit 1; }
          cp apk-icon.png android/app/src/main/res/drawable-nodpi/ic_launcher_fg.png
          for k in asli biru hijau pink merah neon mono; do
            # Cari ikon varian: icon-$k.png di folder utama, atau apk-icons/$k.png. Kalau tidak ada, pakai apk-icon.png supaya build tidak gagal.
            src=apk-icon.png
            if [ -f "icon-$k.png" ]; then src="icon-$k.png"; elif [ -f "apk-icons/$k.png" ]; then src="apk-icons/$k.png"; else echo "Peringatan: ikon varian '$k' tidak ditemukan, memakai apk-icon.png"; fi
            cp "$src" android/app/src/main/res/drawable-nodpi/ic_launcher_fg_$k.png
            printf '<?xml version="1.0" encoding="utf-8"?>\n<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">\n    <background android:drawable="@android:color/black" />\n    <foreground android:drawable="@drawable/ic_launcher_fg_%s" />\n</adaptive-icon>\n' "$k" > android/app/src/main/res/mipmap-anydpi/ic_launcher_$k.xml
          done
          ls -R android | head -40

      - name: Build APK
        working-directory: android
        run: gradle --no-daemon assembleRelease

      - name: Ganti nama APK
        run: cp android/app/build/outputs/apk/release/app-release.apk Loopify.apk

      - uses: actions/upload-artifact@v4
        with:
          name: Loopify-APK
          path: Loopify.apk

      - name: Rilis (unduhan langsung)
        uses: softprops/action-gh-release@v2
        with:
          tag_name: apk-${{ github.run_number }}
          name: Loopify APK ${{ github.run_number }}
          files: Loopify.apk
